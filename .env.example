# Copy karke .env banao. Asli keys kabhi share/upload mat karo.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
# Zero-Touch Automated Login (Optional: Roz roz manual login se chhutkara)
DHAN_PIN=
DHAN_TOTP_SECRET=
MAX_ORDER_QTY=650
KITE_API_KEY=
KITE_API_SECRET=
ACCESS_TOKEN=
ACTIVE_BROKER=dhan
PORT=3000
# 127.0.0.1 = sirf aapka PC. Phone/LAN se kholna ho to 0.0.0.0 (security ka dhyan rakho)
HOST=127.0.0.1
NIFTY_LOT_SIZE=65
# 0 = tick recording band
RECORD_TICKS=1

# Telegram alerts: @BotFather se bot banao, bot ko /start bhejo, phir `node telegram_setup.js` chalao
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 0 = Dhan futures depth (real order flow) band
DHAN_FUT_FLOW=1
# 1 = pehle 3 futures packet console me print (verify karne ke liye)
DEBUG_FLOW=0
